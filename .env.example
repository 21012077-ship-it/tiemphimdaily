# Docker Compose đọc tệp .env đặt cạnh docker-compose.yml.
# Chạy python -c "import secrets; print(secrets.token_hex(32))" để tạo SECRET_KEY.
SECRET_KEY=

# Chỉ dùng khi khởi tạo tài khoản đầu tiên trên cơ sở dữ liệu trống.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Mật khẩu của role appuser trong PostgreSQL chạy bằng Compose.
POSTGRES_PASSWORD=

# Khi chạy với cơ sở dữ liệu riêng, điền chuỗi kết nối do máy chủ cấp.
# DATABASE_URL được ưu tiên nếu có; để trống khi dùng DB mặc định của Compose.
DATABASE_URL=
